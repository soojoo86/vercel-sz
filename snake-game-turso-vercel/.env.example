# ===== Turso 数据库 =====
# 创建方式：turso db create snake-game
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# ===== NextAuth 认证（v5 推荐命名）=====
# 生成方式：openssl rand -hex 32
AUTH_SECRET=please-change-me-to-a-random-32-byte-secret
# 本地开发地址；部署到 Vercel 时会自动注入生产域名，无需填写
AUTH_URL=http://localhost:3000

# 兼容旧版命名（v4 项目迁移用；有 AUTH_SECRET 时可不填）
# NEXTAUTH_SECRET=your-secret-key-here-32-characters
# NEXTAUTH_URL=http://localhost:3000

# ===== 可选：游戏“每日次数”按哪个时区计算（默认 Asia/Shanghai）=====
GAME_TIMEZONE=Asia/Shanghai

# ===== 可选：题库管理后台密码（默认 admin112233sz）=====
# ADMIN_PASSWORD=admin112233sz

# ===== 可选：钉钉扫码登录 =====
# 在钉钉开放平台（https://open-dev.dingtalk.com）创建「企业内部应用」：
# 1. 「应用开发」→「登录与分享」→「回调域名」填【纯域名】（不带 https://、不带路径）
#    例：your-app.vercel.app    （本地开发填 localhost:3000）
# 2. 「凭证与基础信息」页复制 AppKey / AppSecret 填到下面
# 两个变量都配置后，登录页会自动显示「钉钉扫码登录」按钮
# DINGTALK_CLIENT_ID=your-dingtalk-app-key
# DINGTALK_CLIENT_SECRET=your-dingtalk-app-secret

# ===== 可选：开启 NextAuth 调试日志（排查登录问题时设为 true）=====
# 开启后 Vercel Functions 日志会输出 OAuth 全流程细节
# AUTH_DEBUG=true
